# EduTrack Kenya — environment template.
# Copy to .env.local and fill in real values. NEVER commit real secrets.
# [prod] = the app refuses to run in production without it (see src/lib/env.ts).
# Features that are not set up yet simply fail when used; nothing silently falls back in production.

# ---- App -------------------------------------------------------------------
# Public base URL of this deployment, no trailing slash. Used for M-Pesa callbacks.  [prod]
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- Database (PostgreSQL: Neon in dev, AWS RDS in prod) -------------------
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require

# ---- Redis (Upstash in dev, ElastiCache in prod) — queues, rate limits ----
# Use rediss:// (TLS) for hosted Redis.  [prod]
REDIS_URL=redis://localhost:6379

# ---- Auth: Clerk (read implicitly by the Clerk SDK) ------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# ---- Teacher attendance QR signing ----------------------------------------
# Long random string (e.g. `openssl rand -base64 48`). Rotating it invalidates live tokens.  [prod]
QR_TOKEN_SECRET=

# ---- M-Pesa Daraja ---------------------------------------------------------
# "sandbox" or "production". Anything else is rejected.  [prod]
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=

# ---- SMS: Africa's Talking -------------------------------------------------
AT_API_KEY=
# "sandbox" is only allowed outside production.  [prod]
AT_USERNAME=sandbox
AT_SENDER_ID=

# ---- File storage: AWS S3 (exports, report cards) --------------------------
AWS_REGION=af-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=

# ---- Push notifications: Firebase ------------------------------------------
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Keep the literal \n sequences inside the quotes.
FIREBASE_PRIVATE_KEY=
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# ---- Monitoring: Sentry (optional until a DSN exists) ----------------------
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# ---- Dev seeding (prisma db seed) — DELETES ALL DATA in the target database ---
# Your inbox local part for the plus-addressed test accounts, e.g. jane.doe
SEED_EMAIL_LOCAL_PART=
# Typed confirmation: must equal the database NAME in DATABASE_URL. The seed refuses to run in
# production and refuses without this, so it cannot wipe the wrong database by accident.
SEED_CONFIRM_WIPE=
